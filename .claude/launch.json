{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tam-app-dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd TAM_Command_Center && TAM_DEV_MODE=1 TAM_BAMS_TEST_MODE=1 TAM_PORT=8766 .venv/bin/python -m server"
      ],
      "port": 8766
    },
    {
      "name": "tam-frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "TAM_Command_Center/frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "tam-frontend-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "TAM_Command_Center/frontend",
        "run",
        "preview"
      ],
      "port": 4173
    },
    {
      "name": "tam-mockups",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8780",
        "--bind",
        "127.0.0.1",
        "--directory",
        "TAM_Command_Center/mockups"
      ],
      "port": 8780
    }
  ]
}