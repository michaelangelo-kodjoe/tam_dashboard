{
  "name": "tam-command-center-frontend",
  "private": true,
  "version": "0.1.0-dev",
  "type": "module",
  "scripts": {
    "sync-mock": "node scripts/sync-mock.mjs",
    "dev": "npm run sync-mock && vite",
    "build": "npm run sync-mock && tsc --noEmit && vite build",
    "build:api": "tsc --noEmit && VITE_DATA_SOURCE=api vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
